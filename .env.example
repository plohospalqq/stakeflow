# `make env` copies this to .env and replaces POSTGRES_PASSWORD with a random value.

POSTGRES_USER=stakeflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stakeflow
POSTGRES_HOST=localhost
# 5433 on the host so it never collides with a local Postgres on 5432
POSTGRES_PORT=5433

# Sodir DataService (ArcGIS FeatureServer), public, no auth
SODIR_BASE_URL=https://factmaps.sodir.no/api/rest/services/DataService/Data/FeatureServer

# Read-only role for SQL written by the Ask feature (infra/postgres/init/03-reader-role.sh).
# Empty = the role cannot log in and POST /ask answers 503.
STAKEFLOW_READER_PASSWORD=

# Claude API key for POST /ask and POST /scenarios/parse. Empty = both answer 503 and the UI
# keeps its preview. Never commit a real key.
ANTHROPIC_API_KEY=
# Optional overrides (defaults: claude-opus-5-5, medium)
# STAKEFLOW_LLM_MODEL=
# STAKEFLOW_LLM_EFFORT=

# EIA API v2 (Brent). Free key: https://www.eia.gov/opendata/register.php
# Empty = api.data.gov's shared DEMO_KEY (rate-limited, enough for one daily download).
EIA_API_KEY=

# Folder with share price CSVs you downloaded yourself (e.g. EQNR.csv from live.euronext.com).
# Local only, never committed. Empty = <repo>/data/share_prices. See docs/market-data-sources.md
SHARE_PRICES_DIR=
