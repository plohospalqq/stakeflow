# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Secrets: never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials*.json
auth*.json
secrets*.json

# Build artifacts
dist/
build/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# dbt
pipeline/dbt/target/
pipeline/dbt/dbt_packages/
pipeline/dbt/logs/
pipeline/dbt/.user.yml

# Dagster local state
.dagster_home/

# Node
node_modules/
*.local

# Raw data never goes into git: it is re-downloadable from Sodir
data/
*.csv
*.parquet
!pipeline/tests/fixtures/**
# dbt seeds are small curated reference data, not raw data
!pipeline/dbt/seeds/*.csv
